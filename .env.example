# ID de la liga: el número tras "leagueId=" en la URL de tu liga en ESPN
ESPN_LEAGUE_ID=
# Temporada (por defecto, el año actual)
ESPN_SEASON=2026
# Solo para ligas privadas: cookies de tu sesión en espn.com
ESPN_S2=
ESPN_SWID=
# Opcional: el ID de tu equipo (si no, se detecta a partir de ESPN_SWID)
ESPN_TEAM_ID=
